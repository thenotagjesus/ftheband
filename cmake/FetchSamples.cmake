# Downloads the sample library listed in assets/samples.manifest into SAMPLES_DIR.
# Usage: cmake -DMANIFEST=... -DSAMPLES_DIR=... -P cmake/FetchSamples.cmake
# Idempotent: existing non-empty files are skipped. Writes SAMPLES_DIR/samples.map (dest|note|vel|keytrack).
file(STRINGS "${MANIFEST}" lines)
file(MAKE_DIRECTORY "${SAMPLES_DIR}")
set(map "")
set(count 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    string(REPLACE "|" ";" f "${line}")
    list(GET f 0 url)
    list(GET f 1 dest)
    list(GET f 2 note)
    list(GET f 3 vel)
    list(GET f 4 kt)
    set(out "${SAMPLES_DIR}/${dest}")
    set(sz 0)
    if(EXISTS "${out}")
        file(SIZE "${out}" sz)
    endif()
    if(sz EQUAL 0)
        file(DOWNLOAD "${url}" "${out}" STATUS st TLS_VERIFY ON)
        list(GET st 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${out}")
            message(WARNING "Sample download failed (${st}): ${url}")
            continue()
        endif()
        math(EXPR count "${count}+1")
    endif()
    string(APPEND map "${dest}|${note}|${vel}|${kt}\n")
endforeach()
file(WRITE "${SAMPLES_DIR}/samples.map" "${map}")
message(STATUS "Samples ready in ${SAMPLES_DIR} (${count} downloaded this run)")
